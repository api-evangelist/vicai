  "item": [
    {
      "id": "8d15dbbf-4605-4484-bdc7-3e03b1416114",
      "name": "Accounts",
      "description": {
        "content": "GL (General Ledger) accounts are part of your *ERP* **Masterdata**. In\norder to be associated with an invoice line item, key data about the\naccount must be stored in Vic.ai.  These operations allow querying and\nmanipulation of these GL account data.\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "74c170ce-1dbc-463d-b32c-3a5c0319c1b9",
          "name": "List all accounts",
          "request": {
            "name": "List all accounts",
            "description": {
              "content": "Use this request to query the GL account data that are stored in Vic.ai.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v0",
                "accounts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "How many items to return at one time (max 100) (default 100)"
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Which item to start from. See [Pagination](#section/Pagination) for more information."
                },
                {
                  "disabled": false,
                  "key": "since",
                  "value": "<dateTime>",
                  "description": "Datetime value for incremental updates.\n**NOTE**: For external datetimes, the expected format is not in UTC. for\nvic-internal datetimes (see `SinceIsExternal`) the format is UTC.\n"
