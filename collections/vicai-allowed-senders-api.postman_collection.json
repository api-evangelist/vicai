  "item": [
    {
      "id": "b92742e3-f45f-461f-ae58-adbf32defdb1",
      "name": "Allowed Senders",
      "description": {
        "content": "Restricts which sender addresses an email endpoint will accept. Each\nentry is either an `exact` match (full email address) or a `domain`\nmatch (everything from that domain). When the restriction is active\nand an inbound email's sender does not match any entry, the email is\nrejected and not processed.\n",
        "type": "text/plain"
      },
