      "items": [
        {
          "info": {
            "name": "Confirm a credit",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.no.stage.vic.ai/v0/credits/:id/confirm",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The id of the credit."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Confirms a single credit by setting the `confirmedAt` timestamp and\noptionally setting a `remoteId`. This is used to mark a credit as\nconfirmed in an external system.\n"
        },
        {
          "info": {
            "name": "Bulk confirm credits",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.no.stage.vic.ai/v0/credits/confirm",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Bulk confirms multiple credits in a single request. Each credit in the\nrequest body must include an `id`, `confirmedAt` timestamp, and\noptionally a `remoteId`.\n\nIf a credit is not found, the entire bulk confirmation is aborted.\n"
        },
        {
          "info": {
            "name": "Mark credit as failed",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.no.stage.vic.ai/v0/credits/:id/fail",
