        {
          "id": "06c9e8c5-6f71-4c74-b5ec-7c7a023b38d6",
          "name": "Generate CSV reports",
          "request": {
            "name": "Generate CSV reports",
            "description": {
              "content": "Generate all available CSV reports. This operation is asynchronous -\nthe reports will be queued for generation and their status\nwill be NOT_READY initially. Use the GET endpoint to check when reports\nare READY and can be downloaded. This endpoint has rate limiting (max 1 requests\nper hour).\n\n**Note**: This feature is only available to customers with analytics CSV reports enabled.\n\nIf you would like access to the reports please contact Customer Support.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v0",
                "csvReports"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reportStartAt\": \"<dateTime>\",\n  \"reportEndAt\": \"<dateTime>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
