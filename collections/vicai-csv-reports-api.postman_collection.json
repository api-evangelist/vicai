          "name": "List CSV reports status",
          "request": {
            "name": "List CSV reports status",
            "description": {
              "content": "Get the status of all available CSV reports. This endpoint returns a list\nof all supported report types along with their current status (`READY` or `NOT_READY`).\nReports that are `READY` can be downloaded immediately.\n\n**Note**: This feature is only available to customers with analytics CSV reports enabled.\n\nIf you would like access to the reports please contact Customer Support.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v0",
                "csvReports"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
