        {
          "id": "b545f065-3e18-4a59-b101-577d0f1af901",
          "name": "Download CSV report",
          "request": {
            "name": "Download CSV report",
            "description": {
              "content": "Download a specific CSV report by name. Returns a redirect (302) to a\nsigned URL where the CSV file can be downloaded. The report must be in\nREADY status to be downloadable otherwise it will return a 404.\n\n**Note**: This feature is only available to customers with analytics CSV reports enabled.\n\nIf you would like access to the reports please contact Customer Support.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v0",
                "csvReports",
                ":report_name"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "report_name",
                  "description": "(Required) The name of the CSV report to download. Forwards to the location of the CSV file\nand also returns the signedUrl.\n"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "b98f6034-bf61-4f5a-8acd-5dbdc64dd041",
              "name": "Redirect to the CSV file download URL.",
              "originalRequest": {
