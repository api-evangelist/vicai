{
  "opencollection": "1.0.0",
  "info": {
    "name": "Vic.ai Accounts Email Endpoints API",
    "version": "v10.40.4"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Email Endpoints",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List email endpoints",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.no.stage.vic.ai/v2/companies/:company_id/email_endpoints",
            "params": [
              {
                "name": "company_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Lists email endpoints for the company, newest first."
        },
        {
          "info": {
            "name": "Create email endpoint",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.no.stage.vic.ai/v2/companies/:company_id/email_endpoints",
            "params": [
              {
                "name": "company_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new email endpoint. All request fields are optional;\nVic.ai assigns a unique local-part and uses the company's default\ndomain when not specified.\n"
        },
        {
          "info": {
            "name": "Get email endpoint",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.no.stage.vic.ai/v2/email_endpoints/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves a single email endpoint by id."
        },
        {
          "info": {
            "name": "Update email endpoint",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.no.stage.vic.ai/v2/email_endpoints/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an email endpoint. Only the fields supplied in the\nrequest body are changed; omitted fields are left as-is.\n"
        },
        {
          "info": {
            "name": "Delete email endpoint",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.no.stage.vic.ai/v2/email_endpoints/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Permanently deletes an email endpoint. Returns an error if any\nemails have already been delivered through this endpoint.\n"
        }
      ]
    }
  ],
  "bundled": true
}