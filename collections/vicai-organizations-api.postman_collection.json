        {
          "id": "0e85f1cf-bfde-47c3-90ce-b943a60d1619",
          "name": "Create an organization",
          "request": {
            "name": "Create an organization",
            "description": {
              "content": "Create a new organization. The organization is automatically linked to\nthe authenticated partner client. Requires partner authentication\n(obtain a token via `POST /v0/token`).\n\nThis endpoint creates only the organization. Create the first company\nunder it as a separate step with\n`POST /v2/organizations/{organization_id}/companies` — the partner\nbootstrap path, which returns the new company's company-scoped OAuth\nclient. (`POST /v2/companies` also creates companies, but it derives the\norganization from the calling client's existing primary company, so it\ncannot bootstrap the very first company under a brand-new organization.)\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "organizations"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"<string>\",\n  \"billing_timezone\": \"<string>\",\n  \"remote_id\": \"<string>\"\n}",
