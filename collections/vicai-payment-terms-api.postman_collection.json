  "item": [
    {
      "id": "4d854368-e8ef-4a38-9614-326c76a2fbb2",
      "name": "Payment Terms",
      "description": {
        "content": "Payment terms are part of your *ERP* **Masterdata**, and represent\npayment terms that Vic.ai can automatically assign to invoices. Some\nvendors may have a default payment term, and some invoices may have a\nspecific payment term. In either case, Vic.ai can automatically assign\npayment terms to invoices.\n",
        "type": "text/plain"
      },
