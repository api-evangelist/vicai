{
  "opencollection": "1.0.0",
  "info": {
    "name": "Vic.ai Accounts Status API",
    "version": "v10.40.4"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Status",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Health check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.no.stage.vic.ai/v0/healthCheck"
          },
          "docs": "Use this request to obtain a health check statement.\n"
        }
      ]
    }
  ],
  "bundled": true
}