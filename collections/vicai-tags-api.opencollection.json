{
  "opencollection": "1.0.0",
  "info": {
    "name": "Vic.ai Accounts Tags API",
    "version": "v10.40.4"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a list of tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.no.stage.vic.ai/v0/tags",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "How many items to return at one time (max 100) (default 100)"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Which item to start from. See [Pagination](#section/Pagination) for more information."
              }
            ]
          },
          "docs": "Get a list of tags.\nTags are used to categorize entities. Currently the only entity that is\ntaggable are Vendors using the `/vendorTags` endpoint. These are not the\ntags that are used to describe a group of companies.\n"
        },
        {
          "info": {
            "name": "Create a new tag",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.no.stage.vic.ai/v0/tags",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new tag."
        },
        {
          "info": {
            "name": "Update a tag",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.no.stage.vic.ai/v0/tags/:tag_id",
            "params": [
              {
                "name": "tag_id",
                "value": "",
                "type": "path",
                "description": "The id of the tag"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a tag."
        },
        {
          "info": {
            "name": "Delete a tag",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.no.stage.vic.ai/v0/tags/:tag_id",
            "params": [
              {
                "name": "tag_id",
                "value": "",
                "type": "path",
                "description": "The id of the tag"
              }
            ]
          },
          "docs": "Delete a tag. If you delete a tag, any entities that the tags is\nattached to will be deleted as well. This action can not be undone.\n"
        }
      ]
    }
  ],
  "bundled": true
}